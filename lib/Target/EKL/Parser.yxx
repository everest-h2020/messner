%skeleton "lalr1.cc"
%require  "3.5"
%language "c++"

%defines
%define api.namespace       {mlir::ekl::detail}
%define api.parser.class    {ParserImpl}
%define api.token.constructor   true
%define api.value.type      variant
%define api.location.type   {mlir::ekl::ImportLocation}
%define parse.assert        false
%define parse.error         verbose

%locations

%code requires{
#include "ParseDriver.h"

namespace mlir::ekl::detail {

class LexerImpl;

} // namespace mlir::ekl::detail

}

%parse-param                { ParseDriver &driver }
%parse-param                { detail::LexerImpl &lexer }

%{
#include "Lexer.hpp"

#undef  yylex
#define yylex               lexer.lex

#define CHECK(expr)         if (failed(expr)) YYABORT
#define CHECK_VAL(expr)                                                        \
    ({                                                                         \
        const auto maybe = expr;                                               \
        CHECK(maybe);                                                          \
        *maybe;                                                                \
    })

template<class T>
[[nodiscard]] static llvm::SmallVector<T> append(llvm::SmallVector<T> head, T tail)
{
    head.emplace_back(std::move(tail));
    return head;
}
%}

/*--- SPECIAL ----------------------------------------------------------------*/

%token                      END         0 "end of input"

/*--- KEYWORDS ---------------------------------------------------------------*/

%token                      KW_ASSOC    "assoc"
%token                      KW_CONST    "const"
%token                      KW_ELSE     "else"
%token                      KW_EXPORT   "export"
%token                      KW_IMPORT   "import"
%token                      KW_IF       "if"
%token                      KW_IN       "in"
%token                      KW_INIT     "init"
%token                      KW_INOUT    "inout"
%token                      KW_KERNEL   "kernel"
%token                      KW_LET      "let"
%token                      KW_LOCAL    "local"
%token                      KW_OUT      "out"
%token                      KW_REDUCE   "reduce"
%token                      KW_STATIC   "static"
%token                      KW_THEN     "then"
%token                      KW_TYPE     "type"
%token                      KW_USING    "using"
%token                      KW_ZIP      "zip"

/*--- OPERATORS --------------------------------------------------------------*/

%token                      ELLIPSIS    "..."
%token                      UNIFY       "<:"
%token                      COERCE      "!>"
%token                      LOR         "||"
%token                      LAND        "&&"
%token                      EQ          "=="
%token                      EQ_ADD      "=+"
%token                      EQ_MUL      "=*"
%token                      EQ_MIN      "=min"
%token                      EQ_MAX      "=max"
%token                      MAPSTO      "=>"
%token                      NE          "<>"
%token                      LE          "<="
%token                      GE          ">="

/*--- LITERALS ---------------------------------------------------------------*/

%token<bool>                BOOL
%token<extent_t>            INDEX
%token<Number>              NUMBER
%token<StringRef>           STRING
%token<StringRef>           ID

/*--- NON-TERMINALS ----------------------------------------------------------*/

%type<AccessModifier>       access-spec

%type<Expr>                 let-rhs
%type<Expr>                 assoc-rhs
%type<Expr>                 reduce-rhs
%type<Expr>                 let-assoc

%type<StringRef>            reduce-op
%type<Expr>                 assoc-expr
%type<Expr>                 zip-expr
%type<Expr>                 functor
%type<Expr>                 reduce-expr
%type<Expr>                 reduce-init
%type<Expr>                 if-expr

%type<LiteralAttr>          literal

%type<ExprList>             expr-list-0
%type<ExprList>             expr-list-1
%type<Expr>                 expr
%type<Expr>                 expr-0
%type<Expr>                 expr-1
%type<Expr>                 expr-2
%type<Expr>                 expr-3
%type<Expr>                 expr-4
%type<Expr>                 expr-5
%type<Expr>                 expr-6
%type<Expr>                 expr-7
%type<Expr>                 expr-8
%type<Expr>                 expr-9
%type<Expr>                 expr-10
%type<Expr>                 expr-11
%type<Expr>                 expr-12
%type<Expr>                 expr-13

%type<TypeExpr>             type-expr
%type<TypeExpr>             type-expr-0
%type<TypeExpr>             type-expr-1
%type<TypeExpr>             type-spec
%type<ReferenceKind>        ref-spec
%type<Extents>              extent-spec

%type<ConstExpr>            const-expr
%type<ConstExprList>        const-expr-list-0
%type<ConstExprList>        const-expr-list-1
%type<ekl::ArrayAttr>       init-spec

%%

program                     : prog-decl-list-0
                            ;

//===----------------------------------------------------------------------===//
// Program-level declarations
//===----------------------------------------------------------------------===//
//
// Declarations and definitions that are valid at the program level, which are
// simply appended to the container when parsed.

prog-decl-list-0            : prog-decl-list-0 prog-decl
                            | %empty
                            ;

prog-decl                   : type-def ';'
                            | const-def ';'
                            | static-decl ';'
                            | kernel-def
                            | error ';'                                         { CHECK(driver.recover()); }
                            ;

type-def                    : "type" ID[name] '=' type-expr[type]               { driver.typeDef(@name, $name, $type); }
                            ;

const-def                   : "const" ID[name] '=' const-expr[value]            { driver.constDef(@name, $name, $value); }
                            ;

static-decl                 : "static" access-spec[access] ID[name]
                              ':' type-expr[type]
                              init-spec[init]                                   { CHECK(driver.staticDecl(@$, $access, $name, $type, $init)); }
                            ;

access-spec                 : %empty                                            { $$ = AccessModifier::Local; }
                            | "local"                                           { $$ = AccessModifier::Local; }
                            | "import"                                          { $$ = AccessModifier::Import; }
                            | "export"                                          { $$ = AccessModifier::Export; }
                            ;

kernel-def                  : "kernel" ID[name] '('                             { CHECK(driver.beginKernel(@name, $name)); driver.pushScope(@3); }
                              arg-decl-list-0 ')' '{' stmt-list-0 '}'           { driver.popScope(); driver.endKernel(); }
                            ;

//===----------------------------------------------------------------------===//
// Argument declarations
//===----------------------------------------------------------------------===//
//
// Argument declarations always affect the current container, inserting new
// block arguments and declaring new expression symbols.

arg-decl-list-0             : arg-decl-list-1
                            | %empty
                            ;

arg-decl-list-1             : arg-decl-list-1 ',' arg-decl
                            | arg-decl
                            ;

arg-decl                    : ID[name] type-spec[type]                          { CHECK(driver.argDecl(@name, $name, $type)); }
                            ;

//===----------------------------------------------------------------------===//
// Statements
//===----------------------------------------------------------------------===//
//
// Statements that can appear inside a kernel body and are simply appended to
// its body when parsed.

stmt-list-0                 : stmt-list-0 stmt
                            | %empty
                            ;

stmt                        : let-stmt ';'
                            | out-stmt ';'
                            | type-def ';'
                            | const-def ';'
                            | ';'
                            | error ';'                                         { CHECK(driver.recover()); }
                            ;

let-stmt                    : "let" ID[name] let-rhs[value]                     { driver.exprDef(@name, $name, $value); }
                            ;

let-rhs                     : assoc-rhs
                            | let-assoc
                            ;

assoc-rhs                   : '=' expr[yield]                                   { $$ = $yield; }
                            | reduce-op[op] reduce-rhs[yield]                   { $$ = driver.reduce(@$, $op, $yield); }
                            ;

reduce-rhs                  : '('                                               { driver.beginAssoc(); driver.pushScope(@1); }
                              arg-decl-list-0 ')' expr[yield]                   { driver.popScope(); $$ = driver.endAssoc(@$, $yield); }
                            ;

let-assoc                   : '['                                               { driver.beginAssoc(); driver.pushScope(@1); }
                              arg-decl-list-0 ']' assoc-rhs[element]            { driver.popScope(); $$ = driver.endAssoc(@$, $element); }
                            ;

out-stmt                    : "out" ID[name] let-rhs[value]                     { CHECK(driver.outStmt(@$, @name, $name, $value)); }
                            ;


//===----------------------------------------------------------------------===//
// Compound expressions
//===----------------------------------------------------------------------===//
//
// Expressions that result in structured ops.


reduce-op                   : "=+"                                              { $$ = AddOp::getOperationName(); }
                            | "=*"                                              { $$ = MultiplyOp::getOperationName(); }
                            | "=min"                                            { $$ = MinOp::getOperationName(); }
                            | "=max"                                            { $$ = MaxOp::getOperationName(); }
                            ;

assoc-expr                  : "assoc"                                           { driver.beginAssoc(); }
                              functor[map]                                      { $$ = driver.endAssoc(@$, $map); }
                            ;

zip-expr                    : "zip" expr-list-1[operands]                       { driver.beginZip($operands); }
                              "using" functor[combine]                          { $$ = driver.endZip(@$, $combine); }
                            ;

functor                     : '('                                               { driver.pushScope(@1); }
                              arg-decl-list-0 ')' "=>" expr-2[yield]            { driver.popScope(); $$ = $yield; }
                            ;

reduce-expr                 : "reduce" expr-2[array] reduce-init[init]          { driver.beginReduce($array, $init); }
                              "using" functor[yield]                            { $$ = driver.endReduce(@$, $yield); }
                            ;

reduce-init                 : %empty                                            { $$ = {}; }
                            | "init" expr-2[init]                               { $$ = $init; }
                            ;

if-expr                     : "if" expr-0[condition] "then"                     { driver.beginIf($condition); }
                              expr-0[trueValue] "else"                          { driver.beginElse($trueValue); }
                              expr-0[falseValue]                                { $$ = driver.endElse(@$, $falseValue); }
                            ;

//===----------------------------------------------------------------------===//
// Literal expressions
//===----------------------------------------------------------------------===//
//
// A literal expression is an immediate constant expression.

literal                     : BOOL                                              { $$ = driver.getLiteral($1); }
                            | INDEX                                             { $$ = driver.getLiteral($1); }
                            | NUMBER                                            { $$ = driver.getLiteral(std::move($1)); }
                            | STRING                                            { $$ = driver.getLiteral($1); }
                            | ':'                                               { $$ = driver.getIdentityLiteral(); }
                            | '*'                                               { $$ = driver.getExtentLiteral(); }
                            | "..."                                             { $$ = driver.getEllipsisLiteral(); }
                            | '?'                                               { $$ = driver.getErrorLiteral(); }
                            ;

//===----------------------------------------------------------------------===//
// Expressions
//===----------------------------------------------------------------------===//
//
// Expressions create ExpressionOp operations in the current container, and
// track the value that they produce.

expr-list-0                 : expr-list-1
                            | %empty                                            { $$ = {}; }
                            ;

expr-list-1                 : expr-list-1[head] ',' expr[tail]                  { $$ = append(std::move($head), $tail); }
                            | expr                                              { $$ = {$1}; }
                            ;

expr                        : expr-0
                            | if-expr
                            ;

expr-0                      : expr-1
                            | '[' expr-list-1[operands] ']'                     { $$ = driver.expr<StackOp>(@$, $operands); }
                            ;

expr-1                      : expr-2
                            | assoc-expr
                            | reduce-expr
                            | zip-expr
                            | expr-2[condition] '?'
                              expr-2[trueValue]
                              ':' expr-2[falseValue]                            { $$ = driver.expr<ChoiceOp>(@$, $condition, ValueRange{$falseValue, $trueValue}); }
                            ;

expr-2                      : expr-3
                            | expr-3[value] "<:" type-expr[type]                { $$ = driver.expr<UnifyOp>(@$, $value, $type); }
                            | expr-3[value] '~' extent-spec[extents]            { $$ = driver.expr<BroadcastOp>(@$, $value, $extents.getValue()); }
                            | expr-3[value] "!>" type-expr[type]                { $$ = driver.expr<CoerceOp>(@$, $value, $type); }
                            ;

expr-3                      : expr-4
                            | expr-4[lhs] "||" expr-3[rhs]                      { $$ = driver.expr<LogicalOrOp>(@$, $lhs, $rhs); }
                            ;

expr-4                      : expr-5
                            | expr-5[lhs] "&&" expr-4[rhs]                      { $$ = driver.expr<LogicalAndOp>(@$, $lhs, $rhs); }
                            ;

expr-5                      : expr-6
                            | expr-6[lhs] "==" expr-5[rhs]                      { $$ = driver.expr<CompareOp>(@$, RelationKind::Equivalent, $lhs, $rhs); }
                            | expr-6[lhs] "<>" expr-5[rhs]                      { $$ = driver.expr<CompareOp>(@$, RelationKind::Antivalent, $lhs, $rhs); }
                            ;

expr-6                      : expr-7
                            | expr-7[lhs] '<' expr-6[rhs]                       { $$ = driver.expr<CompareOp>(@$, RelationKind::LessThan, $lhs, $rhs); }
                            | expr-7[lhs] "<=" expr-6[rhs]                      { $$ = driver.expr<CompareOp>(@$, RelationKind::LessOrEqual, $lhs, $rhs); }
                            | expr-7[lhs] ">=" expr-6[rhs]                      { $$ = driver.expr<CompareOp>(@$, RelationKind::GreaterOrEqual, $lhs, $rhs); }
                            | expr-7[lhs] '>' expr-6[rhs]                       { $$ = driver.expr<CompareOp>(@$, RelationKind::GreaterThan, $lhs, $rhs); }
                            ;

expr-7                      : expr-8
                            | expr-8[lhs] '+' expr-7[rhs]                       { $$ = driver.expr<AddOp>(@$, $lhs, $rhs); }
                            | expr-8[lhs] '-' expr-7[rhs]                       { $$ = driver.expr<SubtractOp>(@$, $lhs, $rhs); }
                            ;

expr-8                      : expr-9
                            | expr-9[lhs] '#' expr-8[rhs]                       { $$ = driver.expr<TensorProductOp>(@$, $lhs, $rhs); }
                            ;

expr-9                      : expr-10
                            | expr-10[lhs] '*' expr-9[rhs]                      { $$ = driver.expr<MultiplyOp>(@$, $lhs, $rhs); }
                            | expr-10[lhs] '/' expr-9[rhs]                      { $$ = driver.expr<DivideOp>(@$, $lhs, $rhs); }
                            | expr-10[lhs] '%' expr-9[rhs]                      { $$ = driver.expr<RemainderOp>(@$, $lhs, $rhs); }
                            ;

expr-10                     : expr-11
                            | '-' expr-11[operand]                              { $$ = driver.expr<NegateOp>(@$, $operand); }
                            | '~' expr-11[operand]                              { $$ = driver.expr<LogicalNotOp>(@$, $operand); }
                            ;

expr-11                     : expr-12
                            | expr-11[lhs] '^' expr-12[rhs]                     { $$ = driver.expr<PowerOp>(@$, $lhs, $rhs); }
                            ;

expr-12                     : expr-13
                            | expr-13[array] '[' expr-list-1[subscripts] ']'    { $$ = driver.expr<SubscriptOp>(@$, $array, $subscripts); }
                            | ID[callee] '(' expr-list-0[operands] ')'          { $$ = CHECK_VAL(driver.call(@$, @callee, $callee, $operands)); }
                            ;

expr-13                     : literal                                           { $$ = driver.expr<LiteralOp>(@1, $1); }
                            | ID                                                { $$ = CHECK_VAL(driver.resolveExpr(@1, $1)); }
                            | '(' expr ')'                                      { $$ = $expr; }
                            | '{'                                               { driver.pushScope(@1); }
                              stmt-list-0 expr '}'                              { driver.popScope(); $$ = $expr; }
                            | '(' error ')'                                     { CHECK(driver.recover()); }
                            ;

//===----------------------------------------------------------------------===//
// Type expressions
//===----------------------------------------------------------------------===//
//
// Type expressions must always produce a type at parsing time, and are the only
// way to produce a type at all (no types as values).

type-expr                   : type-expr-0
                            | ref-spec[kind] type-expr-0[pointee]               { $$ = CHECK_VAL(driver.refType(@$, $kind, $pointee)); }
                            ;

type-expr-0                 : type-expr-1
                            | type-expr-1[scalar] extent-spec[extents]          { $$ = CHECK_VAL(driver.arrayType(@$, $scalar, $extents)); }
                            ;

type-expr-1                 : ID                                                { $$ = CHECK_VAL(driver.resolveType(@1, $1)); }
                            | INDEX                                             { $$ = {driver.getIndexType($1), @1}; }
                            | '?'                                               { $$ = {driver.getErrorType(), @1}; }
                            ;

type-spec                   : %empty                                            { $$ = {Type{}, @$}; }
                            | ':' type-expr[type]                               { $$ = $type; }
                            ;

ref-spec                    : '&'                                               { $$ = ReferenceKind::In; }
                            | "in" '&'                                          { $$ = ReferenceKind::In; }
                            | "out" '&'                                         { $$ = ReferenceKind::Out; }
                            | "inout" '&'                                       { $$ = ReferenceKind::InOut; }
                            ;

extent-spec                 : '[' const-expr-list-0[extents] ']'                { $$ = CHECK_VAL(driver.extents(@$, $extents)); }
                            ;

//===----------------------------------------------------------------------===//
// Constant expressions
//===----------------------------------------------------------------------===//
//
// Constant expression must always produce a constant value at parsing time, and
// are the only way to produce type parameters (no dependent types). This is
// implemented by accepting arbitrary expressions, and then greedily folding
// them. Thus, constant expressions are directly tied to folder implementations
// of the EKL dialect.
//
// Since the expression parser will insert local operations, pushing a constexpr
// scope creates an ephemeral container region at the current location, which is
// deleted when the scope is popped.

const-expr                  :                                                   { driver.beginConstexpr(); }
                              expr                                              { $$ = CHECK_VAL(driver.endConstexpr($expr)); }
                            ;

const-expr-list-0           : const-expr-list-1
                            | %empty                                            { $$ = {}; }
                            ;

const-expr-list-1           : const-expr-list-1[head] ',' const-expr[tail]      { $$ = append(std::move($head), $tail); }
                            | const-expr                                        { $$ = {$1}; }
                            ;

init-spec                   : '=' const-expr[value]                             { $$ = /*TODO*/{}; }
                            | %empty                                            { $$ = {}; }
                            ;

%%

void mlir::ekl::detail::ParserImpl::error(
    const location_type &location,
    const std::string &message)
{
    driver.emitError(location, message);
}
